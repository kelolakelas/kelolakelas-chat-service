# DATABASE_URL takes precedence over DB_* when set.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat?sslmode=disable
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=chat
# DB_SSLMODE=disable
IDENTITY_GRPC_HOST=localhost:50051
IDENTITY_PERMISSION_TIMEOUT_MS=500
JWT_SECRET=<generate-a-strong-shared-secret>
PORT=8083
# HTTP server timeouts in seconds; zero, negative, or unset uses the default shown.
SERVER_READ_HEADER_TIMEOUT_SECONDS=5
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_WRITE_TIMEOUT_SECONDS=60
SERVER_IDLE_TIMEOUT_SECONDS=120
# How long in-flight requests may drain after SIGINT/SIGTERM; zero, negative, or unset uses 15.
SERVER_SHUTDOWN_TIMEOUT_SECONDS=15
